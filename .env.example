# Copy this file to .env and fill in real values. Never commit .env.

# SQL Server connection (database is created by data/scripts/init_database.sql)
DB_TRUST_SERVER_CERTIFICATE=yes
DB_HOST=localhost
DB_PORT=1433
DB_NAME=DataWarehouse
DB_USER=sa
DB_PASSWORD=your_password_here

# Spark (needs a JDK; set JAVA_HOME in your shell or here)
# JAVA_HOME=C:\Program Files\Java\jdk-17                                  (Windows)
# JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home  (macOS, Homebrew on Apple Silicon)
SPARK_APP_NAME=data-warehouse-medallion
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
SPARK_IVY_DIR=.cache/ivy
DB_JDBC_PACKAGE=com.microsoft.sqlserver:mssql-jdbc:13.4.0.jre11

# Docker SQL Server image (only if running SQL Server in Docker)
MSSQL_SA_PASSWORD=your_password_here
ACCEPT_EULA=Y
